#!/usr/bin/env bash
# ai-desktop — relaunch a desktop app on the account aigate recommends.
#
#   ai-desktop codex    write the best Codex account into auth.json, restart ChatGPT.app
#   ai-desktop claude   launch Claude.app and print which account to sign into
#
# Codex: the app's bundled `codex app-server` reads $CODEX_HOME/auth.json at start,
# so write-then-restart genuinely switches the account.
# Claude: MEASURED 2026-08-20 — Claude for Desktop spawns its Code runtime through
# Contents/Helpers/disclaimer, which OVERWRITES CLAUDE_CODE_OAUTH_TOKEN with the app's
# own OAuth credential (injected ad6c1028fc1a vs spawned 5c4f5ebbb086), and Anthropic's
# docs say Desktop doesn't read these env vars. So the app runs on whatever account is
# signed in INSIDE it; we can only tell you which one to sign into.
set -uo pipefail

AIGATE_DIR="${AIGATE_DIR:-$HOME/.claude/aigate}"
[ -r "$AIGATE_DIR/env" ] && { set -a; . "$AIGATE_DIR/env"; set +a; }
HOST="$(hostname -s)"
CODEX_BUNDLE_ID="${AIGATE_CODEX_BUNDLE_ID:-com.openai.codex}"
CLAUDE_APP="${AIGATE_DESKTOP_APP:-/Applications/Claude.app}"

# ChatGPT.app's bundle path: Spotlight by bundle id, then /Applications. Process matching
# is by THIS path only — T3 and VS Code run their own `codex app-server` that must survive.
codex_app_path(){
  local p="${AIGATE_CODEX_APP_PATH:-}"
  [ -z "$p" ] && p="$(mdfind "kMDItemCFBundleIdentifier == '$CODEX_BUNDLE_ID'" 2>/dev/null | head -1)"
  { [ -n "$p" ] && [ -d "$p" ]; } || p=/Applications/ChatGPT.app
  printf '%s' "${p%/}"
}
app_server_pids(){ # $1 = app bundle path → pids of app-server processes whose executable lives inside it
  [ -n "$1" ] || return 0
  ps -axo pid=,command= 2>/dev/null | python3 -c 'import sys
app=sys.argv[1].rstrip("/")+"/"
for l in sys.stdin:
    f=l.strip().split(None,1)
    if len(f)<2: continue
    c=f[1]
    if c.startswith(app) and "app-server" in c: print(f[0])' "$1"
}
dry_pick(){ # $1 = query prefix ("" | "kind=codex&")
  [ -n "${AIGATE_URL:-}" ] && [ -n "${AIGATE_TOKEN:-}" ] || return 1
  local hf; hf="$(mktemp)"; chmod 600 "$hf"; printf 'Authorization: Bearer %s\n' "$AIGATE_TOKEN" > "$hf"
  curl -s -m15 -H "@$hf" "$AIGATE_URL/api/select?${1}host=$HOST&dry=1" 2>/dev/null
  local rc=$?; rm -f "$hf"; return $rc
}
fmt_pick(){ python3 -c 'import sys,json
try:d=json.load(sys.stdin)
except Exception:d={}
if not d.get("account"): print(""); sys.exit()
p=[str(d["plan"])] if d.get("plan") else []
for k,l in (("five_hour_pct","5h"),("seven_day_pct","7d")):
    if isinstance(d.get(k),(int,float)): p.append("%s %d%%"%(l,round(d[k])))
print("%s (%s)"%(d["account"]," · ".join(p)))' 2>/dev/null; }

case "${1:-}" in
  codex)
    WRITER="$AIGATE_DIR/aigate-codex.sh"
    [ -x "$WRITER" ] || { echo "ai-desktop: $WRITER missing — run aigate's clients/install.sh" >&2; exit 1; }
    APP="$(codex_app_path)"
    osascript -e "quit app id \"$CODEX_BUNDLE_ID\"" >/dev/null 2>&1 || true
    # wait up to ~20s for THIS app's bundled app-server (never T3's or VS Code's) to let go
    for _ in $(seq $(( ${AIGATE_DESKTOP_WAIT_S:-20} * 2 ))); do
      [ -n "$(app_server_pids "$APP")" ] || break
      sleep 0.5
    done
    left="$(app_server_pids "$APP")"
    if [ -n "$left" ]; then
      echo "ai-desktop: ChatGPT's codex app-server still running → TERM" >&2
      for p in $left; do kill -TERM "$p" 2>/dev/null || true; done
      sleep 1
    fi
    # keeper + select + write (STICKY: another live codex on this CODEX_HOME keeps its account).
    # --write-only prints "aigate-account: <name>" = the account ACTUALLY in auth.json now.
    if ! wout="$("$WRITER" --write-only)"; then
      echo "ai-desktop: could not select/write a codex account — reopening ChatGPT on its existing login" >&2
      open -b "$CODEX_BUNDLE_ID" >/dev/null 2>&1 || echo "ai-desktop: could not reopen $CODEX_BUNDLE_ID" >&2
      exit 1
    fi
    written="$(printf '%s\n' "$wout" | sed -n 's/^aigate-account: //p' | tail -n 1)"
    open -b "$CODEX_BUNDLE_ID" || { echo "ai-desktop: could not open $CODEX_BUNDLE_ID" >&2; exit 1; }
    if [ -n "$written" ]; then echo "ai-desktop: ChatGPT/Codex relaunched on $written"
    else echo "ai-desktop: ChatGPT/Codex relaunched on the existing login"; fi
    ;;
  claude)
    [ -d "$CLAUDE_APP" ] || [ -x "$CLAUDE_APP/Contents/MacOS/Claude" ] || { echo "ai-desktop: no Claude.app at $CLAUDE_APP" >&2; exit 1; }
    rec="$(dry_pick '' | fmt_pick)"
    open "$CLAUDE_APP" 2>/dev/null || open -a Claude || { echo "ai-desktop: could not launch Claude.app" >&2; exit 1; }
    if [ -n "$rec" ]; then echo "ai-desktop: aigate recommends: $rec"
    else echo "ai-desktop: aigate has no recommendation right now (unreachable or no headroom)"; fi
    echo "ai-desktop: NOTE — Claude Desktop uses whichever account is signed in INSIDE the app;" >&2
    echo "            it does not read CLAUDE_CODE_OAUTH_TOKEN. Sign into the account above if it differs." >&2
    ;;
  *)
    echo "usage: ai-desktop codex|claude" >&2; exit 64;;
esac
