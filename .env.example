# aigate config — copy to .env

# shared bearer clients send as Authorization: Bearer — generate: openssl rand -hex 24
AIGATE_TOKEN=

# optional master password for the DASHBOARD login. When set, a person signs in with
# this at /api (POST /api/login) and gets a signed HttpOnly session cookie — so humans
# type a memorable password instead of pasting AIGATE_TOKEN, and the token never enters
# the browser. Scripts keep using the Bearer token. Empty = password login disabled.
# Cookie is signed by TOKEN|PASSWORD (rotating either invalidates live sessions) and,
# by default, lasts ~10y ("stay signed in"); override with AIGATE_SESSION_TTL_MS.
AIGATE_DASHBOARD_PASSWORD=
# AIGATE_SESSION_TTL_MS=315360000000

# 32-byte hex key for AES-256-GCM encryption of stored account tokens at rest.
# Generate: openssl rand -hex 32
AIGATE_ENCRYPTION_KEY=

# HTTP listen port + host
PORT=20200
HOST=0.0.0.0

# SQLite path
AIGATE_DB=./data/aigate.db

# Selection: skip any account whose worst-window usage % is >= this (0-100)
AIGATE_HEADROOM_CUTOFF=95

# Usage-poll interval in ms (reads Anthropic rate-limit headroom). 0 disables the poller.
AIGATE_POLL_MS=600000

# Self-heal watchdog: every N ms the daemon pings its own DB; if it's wedged
# the process exits non-zero so the supervisor (docker restart / launchd)
# restarts a fresh one. 0 disables. Default 30000 (30s).
AIGATE_WATCHDOG_MS=30000

# Optional network gate (defense-in-depth under the bearer token).
# Comma-separated LIST — mix CIDR subnets AND single IPs freely.
# A bare IP (no /) = that one host (/32). Empty = allow all. Loopback always OK.
#   e.g. the whole LAN + one external box (a remote Pi):
AIGATE_ALLOW_CIDR=192.168.1.0/24,68.185.216.174

# Trust X-Forwarded-For for the real client IP (network gate + audit logs).
# OFF by default so a DIRECT client can't spoof its source IP past the gate.
# Set to 1 ONLY when aigate sits behind a reverse proxy YOU control (e.g. NPM).
# aigate reads the RIGHTMOST XFF hop (the one your proxy appends), so a
# client-prepended spoof is ignored.
AIGATE_TRUST_PROXY=0

# Optional: only honor X-Forwarded-For when the socket peer is one of these proxy
# IPs (comma-separated). Defense-in-depth on top of TRUST_PROXY. Empty = honor XFF
# from any peer (fine when the port isn't reachable except via the proxy).
AIGATE_TRUSTED_PROXIES=

# Provider-key liveness poll interval in ms (GET <base>/models per oaiCompat key;
# flips 401/403 → status='dead'). 0 disables. Default 3600000 (1h).
AIGATE_KEY_POLL_MS=3600000

# Optional outbound alert webhook (Slack/Discord/generic, receives {text,...} JSON).
# Fires on: 0 selectable accounts (outage), a provider key going dead, a failed
# backup. Empty = disabled.
AIGATE_ALERT_WEBHOOK=

# Auth-failure throttle: after MAX_FAILS bad bearers from one IP within WINDOW_MS,
# lock that IP for LOCK_MS (429). Loopback is exempt.
AIGATE_AUTH_MAX_FAILS=10
AIGATE_AUTH_WINDOW_MS=60000
AIGATE_AUTH_LOCK_MS=300000

# Optional: override the served version string (fleet tar-path deploy stamps the sha).
# Falls back to package.json semver when unset.
AIGATE_VERSION=

# /v1/messages proxy tier aliases (API-key providers only — see the /v1/messages section of README.md). A bare
# claude-* model the real binary sends (background haiku/title-gen calls, or your own
# ANTHROPIC_MODEL) routes through these instead of 404ing on an unmapped tier. Both are
# "provider:model" strings, e.g. openrouter:moonshotai/kimi-k2. Haiku-shaped names use
# SMALL; every other claude-* uses MAIN. Unset = falls back to a vaulted real anthropic
# API key, model unchanged.
# AIGATE_PROXY_MAIN=openrouter:moonshotai/kimi-k2
# AIGATE_PROXY_SMALL=openrouter:moonshotai/kimi-k2

# /v1/messages proxy upstream overrides (defaults: openrouter.ai/api, api.kimi.com/coding,
# api.anthropic.com). Read fresh on every request — mainly for pointing a provider at a
# self-hosted mirror or a test double.
# AIGATE_PROXY_UPSTREAM_OPENROUTER=
# AIGATE_PROXY_UPSTREAM_KIMI=
# AIGATE_PROXY_UPSTREAM_ANTHROPIC=
# Family form: AIGATE_PROXY_UPSTREAM_<NAME>. Defaults:
#   OPENROUTER  https://openrouter.ai/api
#   KIMI        https://api.kimi.com/coding
#   MUSE        https://api.meta.ai
#   QWEN        https://dashscope-intl.aliyuncs.com/api/v2/apps/claude-code-proxy
#   ANTHROPIC   https://api.anthropic.com
# AIGATE_PROXY_UPSTREAM_MUSE=
# AIGATE_PROXY_UPSTREAM_QWEN=

# OpenAI-compatible upstream bases, AIGATE_OAI_UPSTREAM_<NAME>. Trailing slashes are
# stripped. Defaults:
#   OPENAI      https://api.openai.com/v1
#   OPENROUTER  https://openrouter.ai/api/v1
#   QWENCLOUD   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   GROQ        https://api.groq.com/openai/v1
#   DEEPSEEK    https://api.deepseek.com
#   XAI         https://api.x.ai/v1
#   TOGETHER    https://api.together.xyz/v1
#   FIREWORKS   https://api.fireworks.ai/inference/v1
#   VENICE      https://api.venice.ai/api/v1
#   PERPLEXITY  https://api.perplexity.ai
# AIGATE_OAI_UPSTREAM_OPENAI=
# AIGATE_OAI_UPSTREAM_OPENROUTER=
# AIGATE_OAI_UPSTREAM_QWENCLOUD=
# AIGATE_OAI_UPSTREAM_GROQ=
# AIGATE_OAI_UPSTREAM_DEEPSEEK=
# AIGATE_OAI_UPSTREAM_XAI=
# AIGATE_OAI_UPSTREAM_TOGETHER=
# AIGATE_OAI_UPSTREAM_FIREWORKS=
# AIGATE_OAI_UPSTREAM_VENICE=
# AIGATE_OAI_UPSTREAM_PERPLEXITY=

# Codex (ChatGPT OAuth) accounts. All optional; defaults shown.
# AIGATE_CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# AIGATE_CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
# AIGATE_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# User-Agent for the usage poll (override only if the default ever 403s).
# Default: aigate/<version> (codex-usage)
# AIGATE_CODEX_UA=
# Token-endpoint timeout in ms. Generous on purpose: a refresh that may already have been
# sent is unrecoverable if we give up early.
# AIGATE_CODEX_TOKEN_TIMEOUT_MS=60000
# Refresh only when the access token is within this many seconds of expiry (default 4 days).
# AIGATE_CODEX_REFRESH_AHEAD_S=345600
# Refresh-token ledger path. Default: codex-ledger.json beside AIGATE_DB when the DB file is
# aigate.db, else <AIGATE_DB>.codex-ledger.json.
# AIGATE_CODEX_LEDGER=./data/codex-ledger.json

# Spend ledger (usage_events). Days of spend events and session mappings to keep; older rows are
# pruned during the daily snapshot. 0 keeps everything. Default 400, which is also the longest
# range GET /api/spend will serve.
# AIGATE_SPEND_RETENTION_DAYS=400
